# Copy this file to .env.local and fill in your own Supabase project's values.
# Find both at: Supabase dashboard → Project Settings → API

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# --- Only needed for the automatic box-office sync (/api/sync-boxoffice) ---
# SECRET keys below — never the "anon" key. Do not paste real values for
# these into chat or commit them; set them directly in Supabase/Vercel's own
# dashboards, and in your local .env.local for testing.

# Supabase dashboard → Project Settings → API → "service_role" key.
# This bypasses Row Level Security, so it must only ever be used server-side
# (see lib/supabaseAdmin.ts) and never exposed with a NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Any random string you generate yourself, e.g. `openssl rand -hex 32`.
# Protects /api/sync-boxoffice from being triggered by anyone else.
CRON_SECRET=a-long-random-string-you-generate
